# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://lidox:lidox_dev@localhost:5432/lidox
POSTGRES_USER=lidox
POSTGRES_PASSWORD=lidox_dev
POSTGRES_DB=lidox

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT / Auth ────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION_DAYS=7
# Backward-compatible legacy aliases still accepted:
# JWT_EXPIRES_IN=15m
# REFRESH_TOKEN_EXPIRES_IN=7d

# ─── OAuth SSO (optional for PoC) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── AI / Groq ─────────────────────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=gsk_...
# Optional: override default model
# GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# ─── Services ──────────────────────────────────────────────
API_PORT=3001
# Optional explicit FastAPI override if you do not want to reuse API_PORT
# FASTAPI_PORT=3001
SYNC_PORT=3002
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173
WEB_BASE_URL=http://localhost:5173
