C4Container
    title Lidox Platform - Container Diagram (PoC as implemented)

    Person(user, "User", "Edits documents, invokes AI")

    Container_Boundary(platform, "Lidox Platform") {
        Container(web, "Frontend Web App", "React + TipTap + Vite", "Editor UI, presence, AI proposal UX (no offline buffer)")
        Container(api, "Backend API", "NestJS", "REST: auth, documents, permissions, AI invoke + SSE stream")
        Container(sync, "Sync Server", "Hocuspocus + Yjs", "WebSocket CRDT relay, awareness, debounced PG persistence")
        Container(queue, "Job queue", "BullMQ on Redis", "AI task workers calling Groq (or mock)")
        ContainerDb(pg, "PostgreSQL", "PostgreSQL 16", "Users, documents, permissions, versions, AI audit")
        ContainerDb(redis, "Redis", "Redis 7", "Refresh-token deny set (API), optional sync auth checks")
    }

    System_Ext(llm, "Groq / LLM API", "HTTPS text generation")

    Rel(user, web, "Uses", "HTTP")
    Rel(web, api, "REST + SSE", "HTTPS via /api proxy")
    Rel(web, sync, "Yjs sync", "WebSocket :3002")
    Rel(api, queue, "Enqueue AI jobs", "Redis")
    Rel(queue, llm, "Prompt / completion", "HTTPS")
    Rel(api, pg, "Reads / writes", "TCP")
    Rel(sync, pg, "Persist Yjs snapshots", "TCP")
    Rel(api, redis, "Token deny set", "TCP")
