C4Component
    title AI stack - Component view (matches apps/api/src/ai)

    Container_Boundary(api, "NestJS API — AI module") {
        Component(ctrl, "AiController", "NestJS", "invoke, SSE stream, cancel, review, history")
        Component(svc, "AiService", "TypeScript", "Task lifecycle, permissions, streaming bridge")
        Component(proc, "AiProcessor", "BullMQ worker", "Groq calls, mock fallback, status updates")
        Component(store, "Task store / event bus", "In-memory + Redis", "Queued and running tasks")
        Component(adapter, "Provider adapter", "Groq SDK", "Model selection and retries")
        Component(log, "Interaction log", "Drizzle / PG", "Persist costs and proposal metadata")
    }

    Container_Ext(redis, "Redis", "BullMQ queues")
    Container_Ext(pg, "PostgreSQL", "ai_interactions and related tables")
    System_Ext(groq, "Groq API", "HTTPS")

    Rel(ctrl, svc, "Delegates")
    Rel(svc, store, "Create / update tasks")
    Rel(svc, proc, "Enqueue jobs")
    Rel(proc, adapter, "Calls")
    Rel(adapter, groq, "HTTPS")
    Rel(proc, redis, "Queue I/O")
    Rel(svc, log, "Persist audit rows")
    Rel(log, pg, "SQL")
