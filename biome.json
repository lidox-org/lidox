{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": false,
		"indentStyle": "space",
		"indentWidth": 2
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"organizeImports": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": false,
			"complexity": {
				"useLiteralKeys": "error"
			},
			"style": {
				"useNodejsImportProtocol": "error",
				"useNumberNamespace": "error"
			}
		}
	},
	"files": {
		"ignore": ["docs/**/*.pdf", "package-lock.json"]
	}
}
