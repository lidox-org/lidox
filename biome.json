{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": false,
		"indentStyle": "space",
		"indentWidth": 2
	},
	"organizeImports": {
		"enabled": false
	},
	"linter": {
		"enabled": false
	},
	"files": {
		"ignore": ["docs/**/*.pdf"]
	}
}
