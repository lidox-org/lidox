{
	"name": "lidox",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"lint": "node ./node_modules/@biomejs/biome/bin/biome check package.json turbo.json biome.json playwright.config.ts apps packages tests",
		"lint:fix": "node ./node_modules/@biomejs/biome/bin/biome check --write package.json turbo.json biome.json playwright.config.ts apps packages tests",
		"test": "npm run test:api && npm run test:web",
		"test:api": "npm --workspace @lidox/api run test",
		"test:web": "npm --workspace @lidox/web run test",
		"test:unit": "npm run test:api",
		"test:integration": "npm run test:web",
		"test:e2e": "node ./node_modules/@playwright/test/cli.js test",
		"test:e2e:install": "node ./node_modules/playwright/cli.js install --with-deps chromium",
		"typecheck": "turbo run typecheck",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@biomejs/biome": "^1.9.4",
		"turbo": "^2.4.0",
		"typescript": "^5.7.0"
	},
	"engines": {
		"node": ">=20.0.0",
		"npm": ">=11.6.2"
	},
	"packageManager": "npm@11.6.2"
}
