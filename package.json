{
	"name": "lidox",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"lint": "biome check --formatter-enabled=false --linter-enabled=false --organize-imports-enabled=false --no-errors-on-unmatched .",
		"lint:fix": "biome check --write .",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"turbo": "^2.4.0",
		"typescript": "^5.7.0"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"packageManager": "npm@11.6.2"
}
